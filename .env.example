# AI provider. Default: Claude through Anthropic (fill ANTHROPIC_API_KEY, leave AI_PROVIDER empty or "anthropic").
# Any OpenAI-compatible chat API works instead: set AI_PROVIDER=openai-compatible and the three AI_* lines.
#   Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1                      AI_MODEL=openai/gpt-oss-120b
#   Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-3.8-flash
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
CHANNEL3_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
DATABASE_URL=
# A separate database for automated tests (e.g. a second database in the same Neon project). Tests never use DATABASE_URL.
TEST_DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=CareCart <onboarding@resend.dev>
DEMO_CAREGIVER_EMAIL=
APP_URL=http://localhost:3000
CRON_SECRET=
DAILY_AGENT_CALL_CAP=2000
# Natural voice (Groq Orpheus) and speech recognition for browsers without it (Groq Whisper). Optional:
# without a key the browser's own voice is used. VOICE_API_KEY falls back to AI_API_KEY when AI_BASE_URL is Groq.
# Orpheus needs its terms accepted once: https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
VOICE_API_KEY=
VOICE_TTS_VOICE=hannah
DAILY_SPEECH_CAP=3000
