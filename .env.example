# AI provider. Default: Claude through Anthropic (fill ANTHROPIC_API_KEY, leave AI_PROVIDER empty or "anthropic").
# Any OpenAI-compatible chat API works instead: set AI_PROVIDER=openai-compatible and the three AI_* lines.
#   Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1                      AI_MODEL=openai/gpt-oss-120b
#   Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-3.8-flash
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
CHANNEL3_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
